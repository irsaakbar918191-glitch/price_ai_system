SECRET_KEY=price-ai-system-dev-secret
FLASK_ENV=development
PORT=5000
DEBUG=True

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key

HF_API_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq

UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.xlsx,.xls,.csv
DEFAULT_CURRENCY=PKR
# Optional: set only if Tesseract is not in PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
